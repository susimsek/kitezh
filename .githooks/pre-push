#!/usr/bin/env sh
set -eu

MVN="./mvnw"

if [ ! -f "$MVN" ]; then
  echo "[pre-push] Maven wrapper not found: $MVN" >&2
  exit 1
fi

echo "[pre-push] Running Maven verify..."
"$MVN" -B -ntp verify

SONAR_TOKEN_VALUE="${SONAR_TOKEN:-${SONARQUBE_TOKEN:-}}"
if [ -z "$SONAR_TOKEN_VALUE" ]; then
  echo "[pre-push] Sonar token is not configured; Sonar analysis will run in CI."
  exit 0
fi

BRANCH_NAME="$(git branch --show-current)"
if [ -z "$BRANCH_NAME" ]; then
  echo "[pre-push] Unable to determine the current Git branch." >&2
  exit 1
fi

echo "[pre-push] Running Sonar analysis for branch: $BRANCH_NAME"
if [ "$BRANCH_NAME" = "main" ]; then
  SONAR_TOKEN="$SONAR_TOKEN_VALUE" "$MVN" -B -ntp -Psonar initialize sonar:sonar \
    "-Dsonar.java.checkstyle.reportPaths="
else
  SONAR_TOKEN="$SONAR_TOKEN_VALUE" "$MVN" -B -ntp -Psonar initialize sonar:sonar \
    "-Dsonar.branch.name=$BRANCH_NAME" \
    "-Dsonar.java.checkstyle.reportPaths="
fi

echo "[pre-push] Local checks passed. SonarCloud Quality Gate will be enforced by CI."
