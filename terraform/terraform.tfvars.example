cluster_name       = "local"
kubernetes_version = "v1.33.1"
namespace          = "apps"
ingress_namespace  = "ingress-nginx"
ingress_class_name = "nginx"
ingress_host       = "kitezh.127.0.0.1.nip.io"
mcp_ingress_host   = "mcp.kitezh.127.0.0.1.nip.io"
ingress_http_host_port = 9090
ingress_https_host_port = 8443
image_repository   = "docker.io/suayb/kitezh"
image_tag          = "latest"
spring_profile     = "prod"
mcp_image_repository = "docker.io/suayb/kitezh-mcp"
mcp_image_tag = "0.1.5"
mcp_client_secret_name = "kitezh-mcp-client-secret"

# Replace for anything beyond local development.
