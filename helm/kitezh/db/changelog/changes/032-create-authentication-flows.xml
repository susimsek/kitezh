<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="032-01-authentication-flow-sequences" author="susimsek">
		<createSequence sequenceName="authentication_flow_seq" startValue="100" incrementBy="1"/>
		<createSequence sequenceName="authentication_execution_seq" startValue="100" incrementBy="1"/>
	</changeSet>

	<changeSet id="032-02-authentication-flow-tables" author="susimsek">
		<createTable tableName="authentication_flow">
			<column name="id" type="bigint"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_authentication_flow"/></column>
			<column name="alias" type="varchar(100)"><constraints nullable="false" unique="true" uniqueConstraintName="uk_authentication_flow_alias"/></column>
			<column name="name" type="varchar(200)"><constraints nullable="false"/></column>
			<column name="description" type="varchar(1000)"/>
			<column name="flow_type" type="varchar(20)"><constraints nullable="false"/></column>
			<column name="built_in" type="boolean"><constraints nullable="false"/></column>
			<column name="parent_flow_id" type="bigint"/>
			<column name="requirement" type="varchar(20)"/>
			<column name="priority" type="int"><constraints nullable="false"/></column>
			<column name="created_by" type="varchar(100)"><constraints nullable="false"/></column>
			<column name="created_at" type="timestamp"><constraints nullable="false"/></column>
			<column name="last_modified_by" type="varchar(100)"/>
			<column name="updated_at" type="timestamp"><constraints nullable="false"/></column>
		</createTable>
		<addForeignKeyConstraint baseTableName="authentication_flow" baseColumnNames="parent_flow_id" constraintName="fk_authentication_flow_parent" referencedTableName="authentication_flow" referencedColumnNames="id" onDelete="CASCADE"/>
		<createIndex indexName="idx_authentication_flow_parent_priority" tableName="authentication_flow">
			<column name="parent_flow_id"/>
			<column name="priority"/>
		</createIndex>

		<createTable tableName="authentication_execution">
			<column name="id" type="bigint"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_authentication_execution"/></column>
			<column name="flow_id" type="bigint"><constraints nullable="false"/></column>
			<column name="provider_id" type="varchar(100)"><constraints nullable="false"/></column>
			<column name="display_name" type="varchar(200)"><constraints nullable="false"/></column>
			<column name="requirement" type="varchar(20)"><constraints nullable="false"/></column>
			<column name="priority" type="int"><constraints nullable="false"/></column>
			<column name="authenticator_reference" type="varchar(100)"/>
			<column name="configuration" type="varchar(4000)"/>
			<column name="created_by" type="varchar(100)"><constraints nullable="false"/></column>
			<column name="created_at" type="timestamp"><constraints nullable="false"/></column>
			<column name="last_modified_by" type="varchar(100)"/>
			<column name="updated_at" type="timestamp"><constraints nullable="false"/></column>
		</createTable>
		<addForeignKeyConstraint baseTableName="authentication_execution" baseColumnNames="flow_id" constraintName="fk_authentication_execution_flow" referencedTableName="authentication_flow" referencedColumnNames="id" onDelete="CASCADE"/>
		<createIndex indexName="idx_authentication_execution_flow_priority" tableName="authentication_execution">
			<column name="flow_id"/>
			<column name="priority"/>
		</createIndex>

		<createTable tableName="authentication_flow_binding">
			<column name="binding_type" type="varchar(30)"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_authentication_flow_binding"/></column>
			<column name="flow_id" type="bigint"/>
		</createTable>
		<addForeignKeyConstraint baseTableName="authentication_flow_binding" baseColumnNames="flow_id" constraintName="fk_authentication_flow_binding_flow" referencedTableName="authentication_flow" referencedColumnNames="id" onDelete="SET NULL"/>
	</changeSet>

