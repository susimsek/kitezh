<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="027-create-organizations" author="susimsek">
		<createSequence
			sequenceName="organization_seq"
			startValue="1"
			incrementBy="1"
			minValue="1"
			maxValue="9999999999999999"
			cacheSize="100"
			cycle="false"/>
		<createTable tableName="organizations">
			<column name="id" type="bigint" defaultValueSequenceNext="organization_seq">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_organizations"/>
			</column>
			<column name="alias" type="varchar(100)">
				<constraints nullable="false" unique="true" uniqueConstraintName="uk_organizations_alias"/>
			</column>
			<column name="name" type="varchar(200)">
				<constraints nullable="false"/>
			</column>
			<column name="redirect_url" type="varchar(1000)"/>
			<column name="description" type="varchar(2000)"/>
			<column name="enabled" type="boolean" defaultValueBoolean="true">
				<constraints nullable="false"/>
			</column>
			<column name="created_by" type="varchar(100)">
				<constraints nullable="false"/>
			</column>
			<column name="created_at" type="timestamp" defaultValueComputed="${now}">
				<constraints nullable="false"/>
			</column>
			<column name="last_modified_by" type="varchar(100)"/>
			<column name="updated_at" type="timestamp" defaultValueComputed="${now}">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<createTable tableName="organization_attributes">
			<column name="organization_id" type="bigint">
				<constraints nullable="false"/>
			</column>
			<column name="attribute_name" type="varchar(100)">
				<constraints nullable="false"/>
			</column>
			<column name="attribute_value" type="varchar(1000)">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<addPrimaryKey
			tableName="organization_attributes"
			columnNames="organization_id, attribute_name, attribute_value"
			constraintName="pk_organization_attributes"/>
		<addForeignKeyConstraint
			baseTableName="organization_attributes"
			baseColumnNames="organization_id"
			constraintName="fk_organization_attributes_organization"
			referencedTableName="organizations"
			referencedColumnNames="id"/>
		<createIndex indexName="idx_organization_attributes_name" tableName="organization_attributes">
			<column name="attribute_name"/>
		</createIndex>

		<createSequence
			sequenceName="organization_permission_seq"
			startValue="1"
			incrementBy="1"
			minValue="1"
			maxValue="9999999999999999"
			cacheSize="100"
			cycle="false"/>
		<createTable tableName="organization_permissions">
			<column name="id" type="bigint" defaultValueSequenceNext="organization_permission_seq">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_organization_permissions"/>
			</column>
			<column name="organization_id" type="bigint">
				<constraints nullable="false"/>
			</column>
			<column name="user_id" type="bigint">
				<constraints nullable="false"/>
			</column>
			<column name="permission_level" type="varchar(20)">
				<constraints nullable="false"/>
			</column>
			<column name="created_by" type="varchar(100)">
				<constraints nullable="false"/>
			</column>
			<column name="created_at" type="timestamp" defaultValueComputed="${now}">
				<constraints nullable="false"/>
			</column>
			<column name="last_modified_by" type="varchar(100)"/>
			<column name="updated_at" type="timestamp" defaultValueComputed="${now}">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<addUniqueConstraint
			tableName="organization_permissions"
			columnNames="organization_id, user_id"
			constraintName="uk_organization_permissions_user"/>
		<addForeignKeyConstraint
			baseTableName="organization_permissions"
			baseColumnNames="organization_id"
			constraintName="fk_organization_permissions_organization"
			referencedTableName="organizations"
			referencedColumnNames="id"/>
		<addForeignKeyConstraint
			baseTableName="organization_permissions"
			baseColumnNames="user_id"
			constraintName="fk_organization_permissions_user"
			referencedTableName="users"
			referencedColumnNames="id"/>
		<createIndex indexName="idx_organization_permissions_user" tableName="organization_permissions">
			<column name="user_id"/>
		</createIndex>
	</changeSet>
</databaseChangeLog>
