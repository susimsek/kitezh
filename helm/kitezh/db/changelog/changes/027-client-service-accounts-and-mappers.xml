<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="001-add-service-account-flag" author="susimsek">
		<addColumn tableName="users">
			<column name="service_account" type="boolean" defaultValueBoolean="false">
				<constraints nullable="false"/>
			</column>
		</addColumn>
	</changeSet>

	<changeSet id="002-create-client-service-accounts" author="susimsek">
		<createTable tableName="oauth2_service_account">
			<column name="client_id" type="varchar(100)">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_oauth2_service_account"/>
			</column>
			<column name="user_id" type="bigint">
				<constraints nullable="false" unique="true" uniqueConstraintName="uk_oauth2_service_account_user"/>
			</column>
			<column name="created_by" type="varchar(100)"><constraints nullable="false"/></column>
			<column name="created_at" type="timestamp" defaultValueComputed="${now}"><constraints nullable="false"/></column>
			<column name="last_modified_by" type="varchar(100)"/>
			<column name="updated_at" type="timestamp" defaultValueComputed="${now}"><constraints nullable="false"/></column>
		</createTable>
		<addForeignKeyConstraint
			baseTableName="oauth2_service_account"
			baseColumnNames="client_id"
			constraintName="fk_oauth2_service_account_client"
			referencedTableName="oauth2_registered_client"
			referencedColumnNames="id"
			onDelete="CASCADE"/>
		<addForeignKeyConstraint
			baseTableName="oauth2_service_account"
			baseColumnNames="user_id"
			constraintName="fk_oauth2_service_account_user"
			referencedTableName="users"
			referencedColumnNames="id"
			onDelete="CASCADE"/>
	</changeSet>

	<changeSet id="003-create-client-mappers" author="susimsek">
		<createSequence sequenceName="oauth2_client_mapper_seq" startValue="1" incrementBy="1" minValue="1" maxValue="9999999999999999" cacheSize="100" cycle="false"/>
		<createTable tableName="oauth2_client_mapper">
			<column name="id" type="bigint" defaultValueSequenceNext="oauth2_client_mapper_seq">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_oauth2_client_mapper"/>
			</column>
			<column name="client_id" type="varchar(100)"><constraints nullable="false"/></column>
			<column name="name" type="varchar(100)"><constraints nullable="false"/></column>
			<column name="mapper_type" type="varchar(40)"><constraints nullable="false"/></column>
			<column name="source" type="varchar(200)"/>
			<column name="mapper_value" type="varchar(1000)"/>
			<column name="claim_name" type="varchar(200)"><constraints nullable="false"/></column>
			<column name="priority" type="int" defaultValueNumeric="100"><constraints nullable="false"/></column>
			<column name="add_to_id_token" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
			<column name="add_to_access_token" type="boolean" defaultValueBoolean="true"><constraints nullable="false"/></column>
			<column name="created_by" type="varchar(100)"><constraints nullable="false"/></column>
			<column name="created_at" type="timestamp" defaultValueComputed="${now}"><constraints nullable="false"/></column>
			<column name="last_modified_by" type="varchar(100)"/>
			<column name="updated_at" type="timestamp" defaultValueComputed="${now}"><constraints nullable="false"/></column>
		</createTable>
		<addUniqueConstraint tableName="oauth2_client_mapper" columnNames="client_id, name" constraintName="uk_oauth2_client_mapper_client_name"/>
		<addForeignKeyConstraint baseTableName="oauth2_client_mapper" baseColumnNames="client_id" constraintName="fk_oauth2_client_mapper_client" referencedTableName="oauth2_registered_client" referencedColumnNames="id" onDelete="CASCADE"/>
		<createIndex indexName="idx_oauth2_client_mapper_client" tableName="oauth2_client_mapper"><column name="client_id"/></createIndex>
	</changeSet>
</databaseChangeLog>
