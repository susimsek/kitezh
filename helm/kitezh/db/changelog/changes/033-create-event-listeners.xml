<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="025-01-create-event-listeners" author="susimsek">
        <createTable tableName="event_listener_providers">
            <column name="id" type="varchar(36)"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_event_listener_providers"/></column>
            <column name="name" type="varchar(100)"><constraints nullable="false" unique="true" uniqueConstraintName="uk_event_listener_providers_name"/></column>
            <column name="provider_type" type="varchar(30)"><constraints nullable="false"/></column>
            <column name="endpoint_url" type="varchar(1000)"><constraints nullable="false"/></column>
            <column name="enabled" type="boolean"><constraints nullable="false"/></column>
            <column name="max_attempts" type="int"><constraints nullable="false"/></column>
            <column name="backoff_seconds" type="int"><constraints nullable="false"/></column>
            <column name="created_at" type="timestamp"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamp"><constraints nullable="false"/></column>
        </createTable>
        <createTable tableName="event_listener_provider_events">
            <column name="provider_id" type="varchar(36)"><constraints nullable="false" foreignKeyName="fk_event_listener_provider_events_provider" references="event_listener_providers(id)"/></column>
            <column name="event_type" type="varchar(30)"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="event_listener_provider_events" columnNames="provider_id,event_type" constraintName="uk_event_listener_provider_events"/>
        <createTable tableName="event_listener_deliveries">
            <column name="id" type="varchar(36)"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_event_listener_deliveries"/></column>
            <column name="provider_id" type="varchar(36)"><constraints nullable="false" foreignKeyName="fk_event_listener_deliveries_provider" references="event_listener_providers(id)"/></column>
            <column name="event_id" type="varchar(36)"><constraints nullable="false"/></column>
            <column name="event_type" type="varchar(30)"><constraints nullable="false"/></column>
            <column name="payload" type="varchar(10000)"><constraints nullable="false"/></column>
            <column name="status" type="varchar(20)"><constraints nullable="false"/></column>
            <column name="attempts" type="int"><constraints nullable="false"/></column>
            <column name="next_attempt_at" type="timestamp"/>
            <column name="last_error" type="varchar(1000)"/>
            <column name="created_at" type="timestamp"><constraints nullable="false"/></column>
            <column name="completed_at" type="timestamp"/>
        </createTable>
        <createIndex indexName="idx_event_listener_deliveries_status_next_attempt" tableName="event_listener_deliveries">
            <column name="status"/><column name="next_attempt_at"/>
        </createIndex>
        <createIndex indexName="idx_event_listener_deliveries_provider_created" tableName="event_listener_deliveries">
            <column name="provider_id"/><column name="created_at" descending="true"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
