<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="001-create-groups" author="susimsek">
		<createSequence
			sequenceName="group_seq"
			startValue="1"
			incrementBy="1"
			minValue="1"
			maxValue="9999999999999999"
			cacheSize="100"
			cycle="false"/>
		<createTable tableName="groups">
			<column name="id" type="bigint" defaultValueSequenceNext="group_seq">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_groups"/>
			</column>
			<column name="name" type="varchar(100)">
				<constraints nullable="false" unique="true" uniqueConstraintName="uk_groups_name"/>
			</column>
			<column name="parent_id" type="bigint"/>
			<column name="default_group" type="boolean" defaultValueBoolean="false">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<createIndex indexName="idx_groups_parent" tableName="groups">
			<column name="parent_id"/>
		</createIndex>
		<createTable tableName="user_groups">
			<column name="user_id" type="bigint">
				<constraints nullable="false"/>
			</column>
			<column name="group_id" type="bigint">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<addPrimaryKey
			tableName="user_groups"
			columnNames="user_id, group_id"
			constraintName="pk_user_groups"/>
		<addForeignKeyConstraint
			baseTableName="user_groups"
			baseColumnNames="user_id"
			constraintName="fk_user_groups_user"
			referencedTableName="users"
			referencedColumnNames="id"/>
		<addForeignKeyConstraint
			baseTableName="user_groups"
			baseColumnNames="group_id"
			constraintName="fk_user_groups_group"
			referencedTableName="groups"
			referencedColumnNames="id"/>
		<createIndex indexName="idx_user_groups_group" tableName="user_groups">
			<column name="group_id"/>
		</createIndex>
		<createTable tableName="group_authorities">
			<column name="group_id" type="bigint">
				<constraints nullable="false"/>
			</column>
			<column name="authority_id" type="bigint">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<addPrimaryKey
			tableName="group_authorities"
			columnNames="group_id, authority_id"
			constraintName="pk_group_authorities"/>
		<addForeignKeyConstraint
			baseTableName="group_authorities"
			baseColumnNames="group_id"
			constraintName="fk_group_authorities_group"
			referencedTableName="groups"
			referencedColumnNames="id"/>
		<addForeignKeyConstraint
			baseTableName="group_authorities"
			baseColumnNames="authority_id"
			constraintName="fk_group_authorities_authority"
			referencedTableName="authorities"
			referencedColumnNames="id"/>
		<createIndex indexName="idx_group_authorities_authority" tableName="group_authorities">
			<column name="authority_id"/>
		</createIndex>
		<createTable tableName="group_attributes">
			<column name="group_id" type="bigint"><constraints nullable="false"/></column>
			<column name="attribute_name" type="varchar(100)"><constraints nullable="false"/></column>
			<column name="attribute_value" type="varchar(1000)"><constraints nullable="false"/></column>
		</createTable>
		<addPrimaryKey
			tableName="group_attributes"
			columnNames="group_id, attribute_name, attribute_value"
			constraintName="pk_group_attributes"/>
		<addForeignKeyConstraint
			baseTableName="group_attributes"
			baseColumnNames="group_id"
			constraintName="fk_group_attributes_group"
			referencedTableName="groups"
			referencedColumnNames="id"/>
		<createIndex indexName="idx_group_attributes_name" tableName="group_attributes">
			<column name="attribute_name"/>
		</createIndex>
		<createSequence
			sequenceName="group_permission_seq"
			startValue="1"
			incrementBy="1"
			minValue="1"
			maxValue="9999999999999999"
			cacheSize="100"
			cycle="false"/>
		<createTable tableName="group_permissions">
			<column name="id" type="bigint" defaultValueSequenceNext="group_permission_seq">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_group_permissions"/>
			</column>
			<column name="group_id" type="bigint"><constraints nullable="false"/></column>
			<column name="user_id" type="bigint"><constraints nullable="false"/></column>
			<column name="permission" type="varchar(50)"><constraints nullable="false"/></column>
		</createTable>
		<addUniqueConstraint
			tableName="group_permissions"
			columnNames="group_id, user_id, permission"
			constraintName="uk_group_permissions_subject"/>
		<addForeignKeyConstraint
			baseTableName="group_permissions"
			baseColumnNames="group_id"
			constraintName="fk_group_permissions_group"
			referencedTableName="groups"
			referencedColumnNames="id"/>
		<addForeignKeyConstraint
			baseTableName="group_permissions"
			baseColumnNames="user_id"
			constraintName="fk_group_permissions_user"
			referencedTableName="users"
			referencedColumnNames="id"/>
		<createIndex indexName="idx_group_permissions_user" tableName="group_permissions">
			<column name="user_id"/>
		</createIndex>
	</changeSet>

	<changeSet id="002-seed-groups" author="susimsek">
		<loadData
			encoding="UTF-8"
			file="db/data/groups.csv"
			separator=";"
			tableName="groups"
			usePreparedStatements="true">
			<column header="name" type="string"/>
			<column header="parent_id" type="numeric"/>
			<column header="default_group" type="boolean"/>
		</loadData>
		<loadData
			encoding="UTF-8"
			file="db/data/group-authorities.csv"
			separator=";"
			tableName="group_authorities"
			usePreparedStatements="true">
			<column header="group_id" type="numeric"/>
			<column header="authority_id" type="numeric"/>
		</loadData>
		<loadData
			encoding="UTF-8"
			file="db/data/user-groups.csv"
			separator=";"
			tableName="user_groups"
			usePreparedStatements="true">
			<column header="user_id" type="numeric"/>
			<column header="group_id" type="numeric"/>
		</loadData>
	</changeSet>
</databaseChangeLog>
