<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="028-organization-members-and-domains" author="susimsek">
		<createSequence
			sequenceName="organization_member_seq"
			startValue="1"
			incrementBy="1"
			minValue="1"
			maxValue="9999999999999999"
			cacheSize="100"
			cycle="false"/>
		<createTable tableName="organization_members">
			<column name="id" type="bigint" defaultValueSequenceNext="organization_member_seq">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_organization_members"/>
			</column>
			<column name="organization_id" type="bigint">
				<constraints nullable="false"/>
			</column>
			<column name="user_id" type="bigint">
				<constraints nullable="false"/>
			</column>
			<column name="membership_type" type="varchar(20)" defaultValue="UNMANAGED">
				<constraints nullable="false"/>
			</column>
			<column name="created_by" type="varchar(100)">
				<constraints nullable="false"/>
			</column>
			<column name="created_at" type="timestamp" defaultValueComputed="${now}">
				<constraints nullable="false"/>
			</column>
			<column name="last_modified_by" type="varchar(100)"/>
			<column name="updated_at" type="timestamp" defaultValueComputed="${now}">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<addUniqueConstraint
			tableName="organization_members"
			columnNames="organization_id, user_id"
			constraintName="uk_organization_members_user"/>
		<addForeignKeyConstraint
			baseTableName="organization_members"
			baseColumnNames="organization_id"
			constraintName="fk_organization_members_organization"
			referencedTableName="organizations"
			referencedColumnNames="id"/>
		<addForeignKeyConstraint
			baseTableName="organization_members"
			baseColumnNames="user_id"
			constraintName="fk_organization_members_user"
			referencedTableName="users"
			referencedColumnNames="id"/>
		<createIndex indexName="idx_organization_members_user" tableName="organization_members">
			<column name="user_id"/>
		</createIndex>

		<createSequence
			sequenceName="organization_domain_seq"
			startValue="1"
			incrementBy="1"
			minValue="1"
			maxValue="9999999999999999"
			cacheSize="100"
			cycle="false"/>
		<createTable tableName="organization_domains">
			<column name="id" type="bigint" defaultValueSequenceNext="organization_domain_seq">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_organization_domains"/>
			</column>
			<column name="organization_id" type="bigint">
				<constraints nullable="false"/>
			</column>
			<column name="domain" type="varchar(255)">
				<constraints nullable="false" unique="true" uniqueConstraintName="uk_organization_domains_domain"/>
			</column>
			<column name="verification_status" type="varchar(20)" defaultValue="PENDING">
				<constraints nullable="false"/>
			</column>
			<column name="verification_token_hash" type="varchar(64)"/>
			<column name="verification_expires_at" type="timestamp"/>
			<column name="verified_at" type="timestamp"/>
			<column name="created_by" type="varchar(100)">
				<constraints nullable="false"/>
			</column>
			<column name="created_at" type="timestamp" defaultValueComputed="${now}">
				<constraints nullable="false"/>
			</column>
			<column name="last_modified_by" type="varchar(100)"/>
			<column name="updated_at" type="timestamp" defaultValueComputed="${now}">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<addForeignKeyConstraint
			baseTableName="organization_domains"
			baseColumnNames="organization_id"
			constraintName="fk_organization_domains_organization"
			referencedTableName="organizations"
			referencedColumnNames="id"/>
		<createIndex indexName="idx_organization_domains_organization" tableName="organization_domains">
			<column name="organization_id"/>
		</createIndex>
		<createIndex indexName="idx_organization_domains_verification_token" tableName="organization_domains" unique="true">
			<column name="verification_token_hash"/>
		</createIndex>
	</changeSet>
</databaseChangeLog>
