<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="001-create-user-session-table" author="susimsek">
		<createTable tableName="user_session">
			<column name="primary_id" type="char(36)">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_session"/>
			</column>
			<column name="session_id" type="char(36)">
				<constraints nullable="false"/>
			</column>
			<column name="creation_time" type="bigint">
				<constraints nullable="false"/>
			</column>
			<column name="last_access_time" type="bigint">
				<constraints nullable="false"/>
			</column>
			<column name="max_inactive_interval" type="int">
				<constraints nullable="false"/>
			</column>
			<column name="expiry_time" type="bigint">
				<constraints nullable="false"/>
			</column>
			<column name="principal_name" type="varchar(100)"/>
		</createTable>

		<createIndex indexName="user_session_ix1" tableName="user_session" unique="true">
			<column name="session_id"/>
		</createIndex>
		<createIndex indexName="user_session_ix2" tableName="user_session">
			<column name="expiry_time"/>
		</createIndex>
		<createIndex indexName="user_session_ix3" tableName="user_session">
			<column name="principal_name"/>
		</createIndex>
		<createIndex indexName="user_session_ix4" tableName="user_session">
			<column name="principal_name"/>
			<column name="expiry_time"/>
		</createIndex>
	</changeSet>

	<changeSet id="002-create-user-session-attributes-table" author="susimsek">
		<createTable tableName="user_session_attributes">
			<column name="session_primary_id" type="char(36)">
				<constraints nullable="false"/>
			</column>
			<column name="attribute_name" type="varchar(200)">
				<constraints nullable="false"/>
			</column>
			<column name="attribute_bytes" type="${blobType}">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<addPrimaryKey
			tableName="user_session_attributes"
			columnNames="session_primary_id, attribute_name"
			constraintName="pk_user_session_attributes"/>
		<addForeignKeyConstraint
			baseTableName="user_session_attributes"
			baseColumnNames="session_primary_id"
			referencedTableName="user_session"
			referencedColumnNames="primary_id"
			constraintName="fk_user_session_attributes_session"
			onDelete="CASCADE"/>
		<createIndex indexName="user_session_attributes_ix1" tableName="user_session_attributes">
			<column name="session_primary_id"/>
		</createIndex>
	</changeSet>

</databaseChangeLog>
