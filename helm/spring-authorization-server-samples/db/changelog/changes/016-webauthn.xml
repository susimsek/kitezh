<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="016-01-webauthn-credentials" author="susimsek">
        <createTable tableName="user_credentials">
            <column name="credential_id" type="varchar(512)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_user_credentials"/>
            </column>
            <column name="user_entity_user_id" type="varchar(512)"><constraints nullable="false"/></column>
            <column name="public_key" type="${blobType}"><constraints nullable="false"/></column>
            <column name="signature_count" type="bigint"><constraints nullable="false"/></column>
            <column name="uv_initialized" type="boolean"><constraints nullable="false"/></column>
            <column name="backup_eligible" type="boolean"><constraints nullable="false"/></column>
            <column name="authenticator_transports" type="varchar(100)" defaultValue=""><constraints nullable="false"/></column>
            <column name="public_key_credential_type" type="varchar(50)"/>
            <column name="backup_state" type="boolean"><constraints nullable="false"/></column>
            <column name="attestation_object" type="${blobType}"/>
            <column name="attestation_client_data_json" type="${blobType}"/>
            <column name="created" type="timestamp"><constraints nullable="false"/></column>
            <column name="last_used" type="timestamp"><constraints nullable="false"/></column>
            <column name="label" type="varchar(255)" defaultValue=""><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="user_credentials" indexName="idx_user_credentials_user_entity">
            <column name="user_entity_user_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
