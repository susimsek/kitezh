<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="001-create-authority-composites-table" author="susimsek">
		<createTable tableName="authority_composites">
			<column name="role_id" type="bigint"><constraints nullable="false"/></column>
			<column name="child_role_id" type="bigint"><constraints nullable="false"/></column>
		</createTable>
		<addPrimaryKey tableName="authority_composites" columnNames="role_id, child_role_id" constraintName="pk_authority_composites"/>
		<addForeignKeyConstraint baseTableName="authority_composites" baseColumnNames="role_id" constraintName="fk_authority_composites_role" referencedTableName="authorities" referencedColumnNames="id" onDelete="CASCADE"/>
		<addForeignKeyConstraint baseTableName="authority_composites" baseColumnNames="child_role_id" constraintName="fk_authority_composites_child" referencedTableName="authorities" referencedColumnNames="id" onDelete="CASCADE"/>
		<createIndex indexName="idx_authority_composites_child" tableName="authority_composites"><column name="child_role_id"/></createIndex>
	</changeSet>

	<changeSet id="002-create-client-role-composites-table" author="susimsek">
		<createTable tableName="oauth2_client_role_composites">
			<column name="role_id" type="bigint"><constraints nullable="false"/></column>
			<column name="child_role_id" type="bigint"><constraints nullable="false"/></column>
		</createTable>
		<addPrimaryKey tableName="oauth2_client_role_composites" columnNames="role_id, child_role_id" constraintName="pk_oauth2_client_role_composites"/>
		<addForeignKeyConstraint baseTableName="oauth2_client_role_composites" baseColumnNames="role_id" constraintName="fk_oauth2_client_role_composites_role" referencedTableName="oauth2_client_role" referencedColumnNames="id" onDelete="CASCADE"/>
		<addForeignKeyConstraint baseTableName="oauth2_client_role_composites" baseColumnNames="child_role_id" constraintName="fk_oauth2_client_role_composites_child" referencedTableName="oauth2_client_role" referencedColumnNames="id" onDelete="CASCADE"/>
		<createIndex indexName="idx_oauth2_client_role_composites_child" tableName="oauth2_client_role_composites"><column name="child_role_id"/></createIndex>
	</changeSet>

	<changeSet id="003-create-authority-client-composites-table" author="susimsek">
		<createTable tableName="authority_client_composites">
			<column name="role_id" type="bigint"><constraints nullable="false"/></column>
			<column name="child_role_id" type="bigint"><constraints nullable="false"/></column>
		</createTable>
		<addPrimaryKey tableName="authority_client_composites" columnNames="role_id, child_role_id" constraintName="pk_authority_client_composites"/>
		<addForeignKeyConstraint baseTableName="authority_client_composites" baseColumnNames="role_id" constraintName="fk_authority_client_composites_role" referencedTableName="authorities" referencedColumnNames="id" onDelete="CASCADE"/>
		<addForeignKeyConstraint baseTableName="authority_client_composites" baseColumnNames="child_role_id" constraintName="fk_authority_client_composites_child" referencedTableName="oauth2_client_role" referencedColumnNames="id" onDelete="CASCADE"/>
		<createIndex indexName="idx_authority_client_composites_child" tableName="authority_client_composites"><column name="child_role_id"/></createIndex>
	</changeSet>

	<changeSet id="004-create-client-role-realm-composites-table" author="susimsek">
		<createTable tableName="oauth2_client_role_realm_composites">
			<column name="role_id" type="bigint"><constraints nullable="false"/></column>
			<column name="child_role_id" type="bigint"><constraints nullable="false"/></column>
		</createTable>
		<addPrimaryKey tableName="oauth2_client_role_realm_composites" columnNames="role_id, child_role_id" constraintName="pk_client_role_realm_composites"/>
		<addForeignKeyConstraint baseTableName="oauth2_client_role_realm_composites" baseColumnNames="role_id" constraintName="fk_client_role_realm_composites_role" referencedTableName="oauth2_client_role" referencedColumnNames="id" onDelete="CASCADE"/>
		<addForeignKeyConstraint baseTableName="oauth2_client_role_realm_composites" baseColumnNames="child_role_id" constraintName="fk_client_role_realm_composites_child" referencedTableName="authorities" referencedColumnNames="id" onDelete="CASCADE"/>
		<createIndex indexName="idx_client_role_realm_composites_child" tableName="oauth2_client_role_realm_composites"><column name="child_role_id"/></createIndex>
	</changeSet>
</databaseChangeLog>
