{
  "id": null,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Kitezh MCP observability following the Kitezh backend dashboard panel naming and ordering where applicable. Database, cache, user session, and login panels do not apply to this standalone stateless service.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [
    {
      "keepTime": true,
      "targetBlank": true,
      "title": "Kitezh backend dashboard",
      "type": "link",
      "url": "/d/spring-auth-prod/kitezh"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "panels": [],
      "title": "Service Overview",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "1 means MCP process metrics are arriving in Grafana Cloud; 0 means no MCP telemetry series was found.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "count(process_uptime_milliseconds{service_name=\"$service\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "title": "Availability",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Age of the latest OTLP process metric sample.",
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 9,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "(time() - max(timestamp(process_uptime_milliseconds{service_name=\"$service\"}))) or vector(0)",
          "refId": "A"
        }
      ],
      "title": "Telemetry age",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "id": 10,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "max(process_uptime_milliseconds{service_name=\"$service\"}) / 1000",
          "refId": "A"
        }
      ],
      "title": "Process uptime",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Time from process start until the MCP application is ready.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "id": 11,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "max(application_ready_time_milliseconds{service_name=\"$service\"}) / 1000",
          "refId": "A"
        }
      ],
      "title": "Application ready time",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Time from process start until the application context has started.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "id": 12,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "max(application_started_time_milliseconds{service_name=\"$service\"}) / 1000",
          "refId": "A"
        }
      ],
      "title": "Application started time",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "id": 13,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "expr": "jvm_info{service_name=\"$service\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "JVM information",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "id": 101,
      "panels": [],
      "title": "HTTP Metrics & SLO",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Spring Boot HTTP request count uses millisecond-suffixed metric names in this Grafana Cloud stack.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "exemplar": true,
          "expr": "sum by (status) (rate(http_server_requests_milliseconds_count{service_name=\"$service\",uri=~\"/mcp|UNKNOWN\"}[5m])) or on() label_replace(vector(0), \"status\", \"none\", \"__name__\", \".*\")",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ],
      "title": "HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Share of MCP and unmatched HTTP requests that return a 5xx response.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "id": 14,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "exemplar": true,
          "expr": "(100 * sum(rate(http_server_requests_milliseconds_count{service_name=\"$service\",uri=~\"/mcp|UNKNOWN\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_milliseconds_count{service_name=\"$service\",uri=~\"/mcp|UNKNOWN\"}[5m])), 1e-9)) or vector(0)",
          "legendFormat": "5xx %",
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx error rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "id": 16,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "exemplar": true,
          "expr": "sum(rate(http_server_requests_milliseconds_sum{service_name=\"$service\",uri=~\"/mcp|UNKNOWN\"}[5m])) / clamp_min(sum(rate(http_server_requests_milliseconds_count{service_name=\"$service\",uri=~\"/mcp|UNKNOWN\"}[5m])), 1e-9) or vector(0)",
          "legendFormat": "average",
          "refId": "A"
        }
      ],
      "title": "Average response time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 17
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "exemplar": true,
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(http_server_requests_milliseconds_bucket{service_name=\"$service\",uri=~\"/mcp|UNKNOWN\"}[5m]))) and (sum(rate(http_server_requests_milliseconds_count{service_name=\"$service\",uri=~\"/mcp|UNKNOWN\"}[5m])) > 0)) or vector(0)",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "title": "95th percentile response time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 17
      },
      "id": 17,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "exemplar": true,
          "expr": "(histogram_quantile(0.99, sum by (le) (rate(http_server_requests_milliseconds_bucket{service_name=\"$service\",uri=~\"/mcp|UNKNOWN\"}[5m]))) and (sum(rate(http_server_requests_milliseconds_count{service_name=\"$service\",uri=~\"/mcp|UNKNOWN\"}[5m])) > 0)) or vector(0)",
          "legendFormat": "p99",
          "refId": "A"
        }
      ],
      "title": "99th percentile response time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "1 means MCP process telemetry arrived during the last five minutes; this uses OTLP freshness instead of Prometheus scrape health.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 16,
        "y": 17
      },
      "id": 34,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "count_over_time(process_uptime_milliseconds{service_name=\"$service\"}[5m]) > bool 0",
          "refId": "A"
        }
      ],
      "title": "Telemetry availability",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Fraction of MCP and unmatched HTTP responses completed within 250 ms.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 22
      },
      "id": 20,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "exemplar": true,
          "expr": "(sum(rate(http_server_requests_milliseconds_bucket{service_name=\"$service\",uri=~\"/mcp|UNKNOWN\",le=\"250\"}[$__range])) / clamp_min(sum(rate(http_server_requests_milliseconds_count{service_name=\"$service\",uri=~\"/mcp|UNKNOWN\"}[$__range])), 1e-9)) or vector(0)",
          "refId": "A"
        }
      ],
      "title": "Responses under 250 ms",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 22
      },
      "id": 18,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "exemplar": true,
          "expr": "sum(increase(http_server_requests_milliseconds_count{service_name=\"$service\",uri=~\"/mcp|UNKNOWN\"}[$__range])) or vector(0)",
          "refId": "A"
        }
      ],
      "title": "Total HTTP requests",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 22
      },
      "id": 19,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(http_server_requests_active_milliseconds_count{service_name=\"$service\",uri=~\"/mcp|UNKNOWN\"}) or vector(0)",
          "legendFormat": "in-flight",
          "refId": "A"
        }
      ],
      "title": "In-flight HTTP requests",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "id": 21,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "expr": "sum by (uri,method,status,outcome) (rate(http_server_requests_milliseconds_count{service_name=\"$service\"}[5m]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "HTTP requests by route and status",
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "id": 15,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "exemplar": true,
          "expr": "sum by (status) (rate(http_server_requests_milliseconds_count{service_name=\"$service\",uri=~\"/mcp|UNKNOWN\",status=~\"4..|5..\"}[5m]))",
          "legendFormat": "{{status}} {{outcome}}",
          "refId": "A"
        }
      ],
      "title": "HTTP errors by status",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "id": 103,
      "panels": [],
      "title": "JVM Memory & GC",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 16,
        "x": 0,
        "y": 36
      },
      "id": 23,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{service_name=\"$service\",area=\"heap\"})",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "expr": "sum(jvm_memory_committed_bytes{service_name=\"$service\",area=\"heap\"})",
          "legendFormat": "committed",
          "refId": "B"
        }
      ],
      "title": "Heap memory: used and committed",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 36
      },
      "id": 24,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 * jvm_gc_overhead{service_name=\"$service\"}",
          "legendFormat": "pause seconds/sec",
          "refId": "A"
        }
      ],
      "title": "GC overhead",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 41
      },
      "id": 8,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 * sum(jvm_memory_used_bytes{service_name=\"$service\",area=\"heap\"}) / clamp_min((sum(jvm_memory_max_bytes{service_name=\"$service\",area=\"heap\"}) > 0) or sum(jvm_memory_committed_bytes{service_name=\"$service\",area=\"heap\"}), 1)",
          "legendFormat": "Heap used",
          "refId": "A"
        }
      ],
      "title": "JVM heap usage",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 47
      },
      "id": 104,
      "panels": [],
      "title": "JVM Runtime",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 48
      },
      "id": 25,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 * process_cpu_usage{service_name=\"$service\"}",
          "legendFormat": "process %",
