        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_milliseconds_bucket{job=~\"$job\",instance=~\"$instance\",le=\"250\"}[$__range])) / clamp_min(sum(rate(http_server_requests_milliseconds_count{job=~\"$job\",instance=~\"$instance\"}[$__range])), 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "decimals": 2,
