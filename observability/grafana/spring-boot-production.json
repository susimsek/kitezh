    {
      "id": 19,
      "type": "gauge",
      "title": "Availability",
      "description": "Availability based on the presence of the application OTLP process metric.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 16,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "(avg_over_time((count(process_uptime_milliseconds{job=~\"$job\",instance=~\"$instance\"}) > bool 0)[$__range:$__interval]) or vector(0))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        }
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 20,
      "type": "gauge",
      "title": "Responses below 250 ms",
