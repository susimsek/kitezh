{
  "expo": {
    "platforms": ["ios", "android"],
    "name": "Kitezh",
    "slug": "kitezh",
    "version": "0.1.0",
    "scheme": "kitezh",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.susimsek.kitezh.mobile",
      "associatedDomains": [
        "applinks:kitezh.onrender.com",
        "webcredentials:kitezh.onrender.com"
      ]
    },
    "android": {
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "io.github.susimsek.kitezh.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [{ "scheme": "kitezh", "host": "oauth", "path": "/callback" }]
        },
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "kitezh", "host": "logout", "path": "/callback" }
          ]
        },
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "kitezh", "host": "admin", "path": "/oauth/callback" }
          ]
        },
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "kitezh", "host": "admin", "path": "/logout/callback" }
          ]
        },
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [{ "scheme": "kitezh", "host": "social-link", "path": "/callback" }]
        },
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [{ "scheme": "kitezh", "host": "verify-email", "path": "/" }]
        },
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [{ "scheme": "kitezh", "host": "confirm-email", "path": "/" }]
        },
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "kitezh", "host": "reset-password", "path": "/" }
          ]
        },
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kitezh.onrender.com",
              "path": "/verify-email"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kitezh.onrender.com",
              "path": "/confirm-email"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kitezh.onrender.com",
              "path": "/reset-password"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kitezh.onrender.com",
              "path": "/oauth/callback"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kitezh.onrender.com",
              "path": "/logout/callback"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kitezh.onrender.com",
              "path": "/admin/oauth/callback"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kitezh.onrender.com",
              "path": "/admin/logout/callback"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kitezh to use a selected photo as your profile picture."
        }
      ],
      ["expo-secure-store", { "configureAndroidBackup": true }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8f9fa",
          "image": "./assets/splash-icon.png",
          "imageWidth": 112,
          "dark": {
            "backgroundColor": "#212529",
            "image": "./assets/splash-icon-dark.png"
          }
        }
      ]
    ]
  }
}
