{
  "name": "kitezh-mobile",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Kitezh native mobile client",
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --test src/shared.contract.test.ts src/api/account-api.test.ts src/api/admin-api.test.ts src/api/public-api.test.ts src/app/admin-editor.test.ts src/auth/storage.test.ts",
    "test:coverage": "c8 --include='src/**/*.ts' --all --reporter=lcov --reports-dir=coverage node --experimental-strip-types --test src/shared.contract.test.ts src/api/account-api.test.ts src/api/admin-api.test.ts src/api/public-api.test.ts src/app/admin-editor.test.ts src/auth/storage.test.ts && node ../../../scripts/prefix-lcov-paths.mjs coverage/lcov.info src/main/mobile",
    "test:fixture": "node --test e2e/fixture-server.test.mjs",
    "check:boundaries": "node scripts/check-native-boundaries.mjs",
    "check:security": "node scripts/check-native-security.mjs",
    "check:expo-config": "node scripts/check-expo-config.mjs",
    "build:web": "expo export --platform web"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-native-fontawesome": "1.0.0",
    "@kitezh/shared": "file:../shared",
    "expo": "~57.0.27",
    "expo-auth-session": "~57.0.14",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "24.10.1",
    "@types/react": "~19.2.2",
    "c8": "10.1.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "29.7.0",
    "typescript": "~6.0.3"
  }
}
