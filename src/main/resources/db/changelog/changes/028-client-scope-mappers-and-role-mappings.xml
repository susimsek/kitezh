<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="001-create-client-scope-mapper-table" author="susimsek">
		<createSequence sequenceName="oauth2_client_scope_mapper_seq" startValue="1" incrementBy="1" minValue="1" maxValue="9999999999999999" cacheSize="100" cycle="false"/>
		<createTable tableName="oauth2_client_scope_mapper">
			<column name="id" type="bigint" defaultValueSequenceNext="oauth2_client_scope_mapper_seq">
				<constraints nullable="false" primaryKey="true" primaryKeyName="pk_oauth2_client_scope_mapper"/>
			</column>
			<column name="client_scope_id" type="varchar(100)"><constraints nullable="false"/></column>
			<column name="name" type="varchar(100)"><constraints nullable="false"/></column>
			<column name="mapper_type" type="varchar(40)"><constraints nullable="false"/></column>
			<column name="source" type="varchar(200)"/>
			<column name="mapper_value" type="varchar(1000)"/>
			<column name="claim_name" type="varchar(200)"><constraints nullable="false"/></column>
			<column name="priority" type="int" defaultValueNumeric="100"><constraints nullable="false"/></column>
			<column name="add_to_id_token" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
			<column name="add_to_access_token" type="boolean" defaultValueBoolean="true"><constraints nullable="false"/></column>
			<column name="created_by" type="varchar(100)"><constraints nullable="false"/></column>
			<column name="created_at" type="timestamp" defaultValueComputed="${now}"><constraints nullable="false"/></column>
			<column name="last_modified_by" type="varchar(100)"/>
			<column name="updated_at" type="timestamp" defaultValueComputed="${now}"><constraints nullable="false"/></column>
		</createTable>
		<addUniqueConstraint tableName="oauth2_client_scope_mapper" columnNames="client_scope_id, name" constraintName="uk_oauth2_client_scope_mapper_scope_name"/>
		<addForeignKeyConstraint baseTableName="oauth2_client_scope_mapper" baseColumnNames="client_scope_id" constraintName="fk_oauth2_client_scope_mapper_scope" referencedTableName="oauth2_client_scope" referencedColumnNames="id" onDelete="CASCADE"/>
		<createIndex indexName="idx_oauth2_client_scope_mapper_scope" tableName="oauth2_client_scope_mapper"><column name="client_scope_id"/></createIndex>
	</changeSet>

	<changeSet id="002-create-client-scope-application-role-mappings" author="susimsek">
		<createTable tableName="oauth2_client_scope_authorities">
			<column name="client_scope_id" type="varchar(100)"><constraints nullable="false"/></column>
			<column name="authority_id" type="bigint"><constraints nullable="false"/></column>
		</createTable>
		<addPrimaryKey tableName="oauth2_client_scope_authorities" columnNames="client_scope_id, authority_id" constraintName="pk_oauth2_client_scope_authorities"/>
		<addForeignKeyConstraint baseTableName="oauth2_client_scope_authorities" baseColumnNames="client_scope_id" constraintName="fk_oauth2_client_scope_authorities_scope" referencedTableName="oauth2_client_scope" referencedColumnNames="id" onDelete="CASCADE"/>
		<addForeignKeyConstraint baseTableName="oauth2_client_scope_authorities" baseColumnNames="authority_id" constraintName="fk_oauth2_client_scope_authorities_authority" referencedTableName="authorities" referencedColumnNames="id" onDelete="CASCADE"/>
		<createIndex indexName="idx_oauth2_client_scope_authorities_authority" tableName="oauth2_client_scope_authorities"><column name="authority_id"/></createIndex>
	</changeSet>

	<changeSet id="003-create-client-scope-client-role-mappings" author="susimsek">
		<createTable tableName="oauth2_client_scope_client_roles">
			<column name="client_scope_id" type="varchar(100)"><constraints nullable="false"/></column>
			<column name="client_role_id" type="bigint"><constraints nullable="false"/></column>
		</createTable>
		<addPrimaryKey tableName="oauth2_client_scope_client_roles" columnNames="client_scope_id, client_role_id" constraintName="pk_oauth2_client_scope_client_roles"/>
		<addForeignKeyConstraint baseTableName="oauth2_client_scope_client_roles" baseColumnNames="client_scope_id" constraintName="fk_oauth2_client_scope_client_roles_scope" referencedTableName="oauth2_client_scope" referencedColumnNames="id" onDelete="CASCADE"/>
		<addForeignKeyConstraint baseTableName="oauth2_client_scope_client_roles" baseColumnNames="client_role_id" constraintName="fk_oauth2_client_scope_client_roles_role" referencedTableName="oauth2_client_role" referencedColumnNames="id" onDelete="CASCADE"/>
		<createIndex indexName="idx_oauth2_client_scope_client_roles_role" tableName="oauth2_client_scope_client_roles"><column name="client_role_id"/></createIndex>
	</changeSet>
</databaseChangeLog>
