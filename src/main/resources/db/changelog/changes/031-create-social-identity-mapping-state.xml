<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
	<changeSet id="031-create-social-identity-mapping-state" author="susimsek">
		<createTable tableName="social_identity_synced_roles">
			<column name="identity_id" type="bigint"><constraints nullable="false"/></column>
			<column name="role_name" type="varchar(200)"><constraints nullable="false"/></column>
		</createTable>
		<addPrimaryKey tableName="social_identity_synced_roles" columnNames="identity_id,role_name" constraintName="pk_social_identity_synced_roles"/>
		<addForeignKeyConstraint baseTableName="social_identity_synced_roles" baseColumnNames="identity_id" constraintName="fk_social_identity_synced_roles_identity" referencedTableName="social_identities" referencedColumnNames="id" onDelete="CASCADE"/>

		<createTable tableName="social_identity_synced_groups">
			<column name="identity_id" type="bigint"><constraints nullable="false"/></column>
			<column name="group_name" type="varchar(100)"><constraints nullable="false"/></column>
		</createTable>
		<addPrimaryKey tableName="social_identity_synced_groups" columnNames="identity_id,group_name" constraintName="pk_social_identity_synced_groups"/>
		<addForeignKeyConstraint baseTableName="social_identity_synced_groups" baseColumnNames="identity_id" constraintName="fk_social_identity_synced_groups_identity" referencedTableName="social_identities" referencedColumnNames="id" onDelete="CASCADE"/>
	</changeSet>
</databaseChangeLog>
