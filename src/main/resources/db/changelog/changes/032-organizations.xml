<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
	<changeSet id="032-organizations" author="susimsek">
		<createSequence sequenceName="organization_seq" startValue="1" incrementBy="1" minValue="1" maxValue="9999999999999999" cacheSize="100" cycle="false"/>
		<createSequence sequenceName="organization_member_seq" startValue="1" incrementBy="1" minValue="1" maxValue="9999999999999999" cacheSize="100" cycle="false"/>
		<createSequence sequenceName="organization_domain_seq" startValue="1" incrementBy="1" minValue="1" maxValue="9999999999999999" cacheSize="100" cycle="false"/>
		<createSequence sequenceName="organization_invitation_seq" startValue="1" incrementBy="1" minValue="1" maxValue="9999999999999999" cacheSize="100" cycle="false"/>
		<createSequence sequenceName="organization_group_seq" startValue="1" incrementBy="1" minValue="1" maxValue="9999999999999999" cacheSize="100" cycle="false"/>
		<createSequence sequenceName="organization_group_member_seq" startValue="1" incrementBy="1" minValue="1" maxValue="9999999999999999" cacheSize="100" cycle="false"/>
		<createSequence sequenceName="organization_claim_seq" startValue="1" incrementBy="1" minValue="1" maxValue="9999999999999999" cacheSize="100" cycle="false"/>
		<createSequence sequenceName="organization_provider_seq" startValue="1" incrementBy="1" minValue="1" maxValue="9999999999999999" cacheSize="100" cycle="false"/>

		<createTable tableName="organizations">
			<column name="id" type="bigint" defaultValueSequenceNext="organization_seq"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_organizations"/></column>
			<column name="alias" type="varchar(100)"><constraints nullable="false" unique="true" uniqueConstraintName="uk_organizations_alias"/></column>
			<column name="name" type="varchar(200)"><constraints nullable="false"/></column>
			<column name="display_name" type="varchar(200)"/>
			<column name="description" type="varchar(2000)"/>
			<column name="enabled" type="boolean" defaultValueBoolean="true"><constraints nullable="false"/></column>
		</createTable>

		<createTable tableName="organization_members">
			<column name="id" type="bigint" defaultValueSequenceNext="organization_member_seq"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_organization_members"/></column>
			<column name="organization_id" type="bigint"><constraints nullable="false"/></column>
			<column name="user_id" type="bigint"><constraints nullable="false"/></column>
			<column name="role" type="varchar(30)" defaultValue="MEMBER"><constraints nullable="false"/></column>
			<column name="joined_at" type="timestamp" defaultValueDate="${now}"><constraints nullable="false"/></column>
		</createTable>
		<addUniqueConstraint tableName="organization_members" columnNames="organization_id,user_id" constraintName="uk_organization_members_subject"/>
		<addForeignKeyConstraint baseTableName="organization_members" baseColumnNames="organization_id" constraintName="fk_organization_members_organization" referencedTableName="organizations" referencedColumnNames="id" onDelete="CASCADE"/>
		<addForeignKeyConstraint baseTableName="organization_members" baseColumnNames="user_id" constraintName="fk_organization_members_user" referencedTableName="users" referencedColumnNames="id"/>
		<createIndex indexName="idx_organization_members_user" tableName="organization_members"><column name="user_id"/></createIndex>

		<createTable tableName="organization_domains">
			<column name="id" type="bigint" defaultValueSequenceNext="organization_domain_seq"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_organization_domains"/></column>
			<column name="organization_id" type="bigint"><constraints nullable="false"/></column>
			<column name="domain" type="varchar(255)"><constraints nullable="false" unique="true" uniqueConstraintName="uk_organization_domains_domain"/></column>
			<column name="verified" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
			<column name="verification_token" type="varchar(100)"><constraints nullable="false"/></column>
			<column name="verified_at" type="timestamp"/>
		</createTable>
		<addForeignKeyConstraint baseTableName="organization_domains" baseColumnNames="organization_id" constraintName="fk_organization_domains_organization" referencedTableName="organizations" referencedColumnNames="id" onDelete="CASCADE"/>

		<createTable tableName="organization_invitations">
			<column name="id" type="bigint" defaultValueSequenceNext="organization_invitation_seq"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_organization_invitations"/></column>
			<column name="organization_id" type="bigint"><constraints nullable="false"/></column>
			<column name="email" type="varchar(200)"><constraints nullable="false"/></column>
			<column name="role" type="varchar(30)" defaultValue="MEMBER"><constraints nullable="false"/></column>
			<column name="token_hash" type="varchar(64)"><constraints nullable="false" unique="true" uniqueConstraintName="uk_organization_invitations_token"/></column>
			<column name="expires_at" type="timestamp"><constraints nullable="false"/></column>
			<column name="accepted_at" type="timestamp"/>
			<column name="revoked_at" type="timestamp"/>
			<column name="created_at" type="timestamp" defaultValueDate="${now}"><constraints nullable="false"/></column>
		</createTable>
		<addForeignKeyConstraint baseTableName="organization_invitations" baseColumnNames="organization_id" constraintName="fk_organization_invitations_organization" referencedTableName="organizations" referencedColumnNames="id" onDelete="CASCADE"/>
		<createIndex indexName="idx_organization_invitations_org" tableName="organization_invitations"><column name="organization_id"/><column name="created_at"/></createIndex>

		<createTable tableName="organization_groups">
			<column name="id" type="bigint" defaultValueSequenceNext="organization_group_seq"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_organization_groups"/></column>
			<column name="organization_id" type="bigint"><constraints nullable="false"/></column>
			<column name="parent_id" type="bigint"/>
			<column name="name" type="varchar(100)"><constraints nullable="false"/></column>
		</createTable>
		<addUniqueConstraint tableName="organization_groups" columnNames="organization_id,name" constraintName="uk_organization_groups_name"/>
		<addForeignKeyConstraint baseTableName="organization_groups" baseColumnNames="organization_id" constraintName="fk_organization_groups_organization" referencedTableName="organizations" referencedColumnNames="id" onDelete="CASCADE"/>
		<addForeignKeyConstraint baseTableName="organization_groups" baseColumnNames="parent_id" constraintName="fk_organization_groups_parent" referencedTableName="organization_groups" referencedColumnNames="id" onDelete="CASCADE"/>
		<createIndex indexName="idx_organization_groups_parent" tableName="organization_groups"><column name="parent_id"/></createIndex>

		<createTable tableName="organization_group_members">
			<column name="id" type="bigint" defaultValueSequenceNext="organization_group_member_seq"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_organization_group_members"/></column>
			<column name="group_id" type="bigint"><constraints nullable="false"/></column>
			<column name="user_id" type="bigint"><constraints nullable="false"/></column>
			<column name="joined_at" type="timestamp" defaultValueDate="${now}"><constraints nullable="false"/></column>
		</createTable>
		<addUniqueConstraint tableName="organization_group_members" columnNames="group_id,user_id" constraintName="uk_organization_group_members_subject"/>
		<addForeignKeyConstraint baseTableName="organization_group_members" baseColumnNames="group_id" constraintName="fk_organization_group_members_group" referencedTableName="organization_groups" referencedColumnNames="id" onDelete="CASCADE"/>
		<addForeignKeyConstraint baseTableName="organization_group_members" baseColumnNames="user_id" constraintName="fk_organization_group_members_user" referencedTableName="users" referencedColumnNames="id"/>

		<createTable tableName="organization_claims">
			<column name="id" type="bigint" defaultValueSequenceNext="organization_claim_seq"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_organization_claims"/></column>
			<column name="organization_id" type="bigint"><constraints nullable="false"/></column>
			<column name="claim_name" type="varchar(200)"><constraints nullable="false"/></column>
			<column name="claim_value" type="varchar(2000)"><constraints nullable="false"/></column>
			<column name="add_to_access_token" type="boolean" defaultValueBoolean="true"><constraints nullable="false"/></column>
			<column name="add_to_id_token" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
			<column name="add_to_user_info" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
		</createTable>
		<addUniqueConstraint tableName="organization_claims" columnNames="organization_id,claim_name" constraintName="uk_organization_claims_name"/>
		<addForeignKeyConstraint baseTableName="organization_claims" baseColumnNames="organization_id" constraintName="fk_organization_claims_organization" referencedTableName="organizations" referencedColumnNames="id" onDelete="CASCADE"/>

		<createTable tableName="organization_identity_providers">
			<column name="id" type="bigint" defaultValueSequenceNext="organization_provider_seq"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_organization_identity_providers"/></column>
			<column name="organization_id" type="bigint"><constraints nullable="false"/></column>
			<column name="provider_alias" type="varchar(100)"><constraints nullable="false"/></column>
		</createTable>
		<addUniqueConstraint tableName="organization_identity_providers" columnNames="organization_id,provider_alias" constraintName="uk_organization_identity_providers_link"/>
		<addForeignKeyConstraint baseTableName="organization_identity_providers" baseColumnNames="organization_id" constraintName="fk_organization_identity_providers_organization" referencedTableName="organizations" referencedColumnNames="id" onDelete="CASCADE"/>
		<createIndex indexName="idx_organization_identity_providers_alias" tableName="organization_identity_providers"><column name="provider_alias"/></createIndex>
	</changeSet>
</databaseChangeLog>
