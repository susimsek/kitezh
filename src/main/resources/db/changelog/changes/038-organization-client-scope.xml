<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="030-organization-client-scope" author="susimsek">
		<insert tableName="oauth2_client_scope">
			<column name="id" value="scope-organization"/>
			<column name="name" value="organization"/>
			<column name="display_name" value="Organization"/>
			<column name="description" value="Organization membership claims."/>
			<column name="group_mapper_enabled" valueBoolean="false"/>
			<column name="group_claim_name" value="groups"/>
			<column name="group_mapper_full_path" valueBoolean="true"/>
			<column name="created_by" value="system"/>
			<column name="created_at" valueDate="${now}"/>
			<column name="last_modified_by" value="system"/>
			<column name="updated_at" valueDate="${now}"/>
		</insert>
	</changeSet>
</databaseChangeLog>
