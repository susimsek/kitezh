<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
	xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

	<changeSet id="031-organization-groups" author="susimsek">
		<createSequence sequenceName="organization_group_seq" startValue="1" incrementBy="1" minValue="1" maxValue="9999999999999999" cacheSize="100" cycle="false"/>
		<createSequence sequenceName="organization_group_member_seq" startValue="1" incrementBy="1" minValue="1" maxValue="9999999999999999" cacheSize="100" cycle="false"/>
		<createTable tableName="organization_groups">
			<column name="id" type="bigint" defaultValueSequenceNext="organization_group_seq"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_organization_groups"/></column>
			<column name="organization_id" type="bigint"><constraints nullable="false"/></column>
			<column name="name" type="varchar(100)"><constraints nullable="false"/></column>
			<column name="description" type="varchar(2000)"/>
			<column name="enabled" type="boolean" defaultValueBoolean="true"><constraints nullable="false"/></column>
			<column name="created_by" type="varchar(100)"><constraints nullable="false"/></column>
			<column name="created_at" type="timestamp" defaultValueComputed="${now}"><constraints nullable="false"/></column>
			<column name="last_modified_by" type="varchar(100)"/>
			<column name="updated_at" type="timestamp" defaultValueComputed="${now}"><constraints nullable="false"/></column>
		</createTable>
		<addUniqueConstraint tableName="organization_groups" columnNames="organization_id,name" constraintName="uk_organization_groups_name"/>
		<addForeignKeyConstraint baseTableName="organization_groups" baseColumnNames="organization_id" constraintName="fk_organization_groups_organization" referencedTableName="organizations" referencedColumnNames="id"/>
		<createIndex indexName="idx_organization_groups_organization" tableName="organization_groups"><column name="organization_id"/><column name="name"/></createIndex>
		<createTable tableName="organization_group_roles">
			<column name="group_id" type="bigint"><constraints nullable="false"/></column>
			<column name="role" type="varchar(100)"><constraints nullable="false"/></column>
		</createTable>
		<addPrimaryKey tableName="organization_group_roles" columnNames="group_id,role" constraintName="pk_organization_group_roles"/>
		<addForeignKeyConstraint baseTableName="organization_group_roles" baseColumnNames="group_id" constraintName="fk_organization_group_roles_group" referencedTableName="organization_groups" referencedColumnNames="id"/>
		<createTable tableName="organization_group_members">
			<column name="id" type="bigint" defaultValueSequenceNext="organization_group_member_seq"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_organization_group_members"/></column>
			<column name="group_id" type="bigint"><constraints nullable="false"/></column>
			<column name="user_id" type="bigint"><constraints nullable="false"/></column>
			<column name="created_by" type="varchar(100)"><constraints nullable="false"/></column>
			<column name="created_at" type="timestamp" defaultValueComputed="${now}"><constraints nullable="false"/></column>
			<column name="last_modified_by" type="varchar(100)"/>
			<column name="updated_at" type="timestamp" defaultValueComputed="${now}"><constraints nullable="false"/></column>
		</createTable>
		<addUniqueConstraint tableName="organization_group_members" columnNames="group_id,user_id" constraintName="uk_organization_group_members_user"/>
		<addForeignKeyConstraint baseTableName="organization_group_members" baseColumnNames="group_id" constraintName="fk_organization_group_members_group" referencedTableName="organization_groups" referencedColumnNames="id"/>
		<addForeignKeyConstraint baseTableName="organization_group_members" baseColumnNames="user_id" constraintName="fk_organization_group_members_user" referencedTableName="users" referencedColumnNames="id"/>
		<createIndex indexName="idx_organization_group_members_group" tableName="organization_group_members"><column name="group_id"/></createIndex>
		<createIndex indexName="idx_organization_group_members_user" tableName="organization_group_members"><column name="user_id"/></createIndex>
	</changeSet>
</databaseChangeLog>
