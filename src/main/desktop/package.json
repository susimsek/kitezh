{
  "name": "spring-authorization-server-samples-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop console for Spring Authorization Server Samples",
  "author": {
    "name": "Suayb Simsek",
    "email": "susimsek@users.noreply.github.com"
  },
  "homepage": "https://github.com/susimsek/spring-authorization-server-samples",
  "repository": {
    "type": "git",
    "url": "https://github.com/susimsek/spring-authorization-server-samples.git"
  },
  "main": "dist/main.js",
  "type": "commonjs",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "typecheck": "tsc --noEmit",
    "build:main": "tsc -p tsconfig.json",
    "test:unit": "pnpm run build:main && node --test test/**/*.test.mjs",
    "test": "pnpm run test:unit",
    "test:e2e": "pnpm run build && node --test e2e/**/*.test.mjs",
    "build": "pnpm run build:renderer && tsc -p tsconfig.json",
    "start": "node scripts/run-desktop.mjs production",
    "dev": "node scripts/run-desktop.mjs local",
    "package": "pnpm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright-core": "1.63.0",
    "typescript": "5.9.2"
  },
  "build": {
    "appId": "io.github.susimsek.springauthserversamples.desktop",
    "productName": "Spring Authorization Server",
    "directories": {
      "output": "release"
    },
    "icon": "assets/icon.png",
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Spring Authorization Server OAuth callback",
        "schemes": [
          "springauth"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "publish": {
    "provider": "github",
    "owner": "susimsek",
    "repo": "spring-authorization-server-samples",
    "releaseType": "release"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
