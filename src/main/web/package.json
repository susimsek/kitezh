{
  "name": "kitezh-web",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Web administration and account consoles for the Kitezh identity and access platform",
  "homepage": "https://kitezh.onrender.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/susimsek/kitezh.git"
  },
  "bugs": {
    "url": "https://github.com/susimsek/kitezh/issues"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "jest",
    "test:unit:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chrome": "playwright test --project=chromium",
    "test:e2e:admin": "playwright test e2e/admin-console.spec.ts",
    "test:e2e:account": "playwright test e2e/account-console.spec.ts",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@kitezh/shared": "file:../shared",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@reduxjs/toolkit": "2.12.0",
    "axios": "^1.19.0",
    "bootstrap": "5.3.8",
    "i18next": "^26.4.1",
    "next": "16.3.1",
    "next-i18next": "16.0.11",
    "react": "19.2.8",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.13",
    "react-redux": "9.3.0",
    "react-router-dom": "7.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "5.9.2"
  }
}
