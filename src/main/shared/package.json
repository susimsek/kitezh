{
  "name": "@kitezh/shared",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Platform-neutral Kitezh contracts, design tokens, and API transport",
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme.ts",
    "./theme/runtime": "./src/theme-runtime.cjs",
    "./i18n": "./src/i18n.ts",
    "./icons": "./src/icons.ts",
    "./contracts": "./src/contracts.ts",
    "./api": "./src/api.ts",
    "./api-client": "./src/api-client.cjs",
    "./auth": "./src/auth.ts",
    "./session": "./src/session.ts",
    "./client-metadata": {
      "types": "./src/client-metadata.d.cts",
      "require": "./src/client-metadata.cjs",
      "default": "./src/client-metadata.cjs"
    }
  }
}
